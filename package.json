{
  "name": "seiheki-rouei",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "DLsiteの購入作品からタグランキングを作るChrome拡張",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "css-select": "7.0.0",
    "esbuild": "0.28.2",
    "htmlparser2": "12.0.0"
  }
}
